# Copy to airflow/.env (git-ignored). Never commit real values.

# local = DuckDB stand-in (no account needed); dev = Snowflake DAILY_EXPENSE_TRACKER_FINTECH_APPLICATION_SANDBOX
LAKEHOUSE_TARGET=local

# Snowflake DAILY_EXPENSE_TRACKER_FINTECH_APPLICATION_SANDBOX, key-pair auth. Used by TrackedSnowflakeHook (Airflow connection)
# and by dbt (env vars), only when LAKEHOUSE_TARGET=dev.
# Put the key in .secrets/ at the repo root (git-ignored); it is mounted at /opt/daily-expense-tracker-fintech-application/.secrets.
# AIRFLOW_CONN_SNOWFLAKE_LAKEHOUSE='{"conn_type": "snowflake", "login": "<user>", "extra": {"account": "<account>", "warehouse": "DAILY_EXPENSE_TRACKER_FINTECH_APPLICATION_PIPELINE_XS", "database": "DAILY_EXPENSE_TRACKER_FINTECH_APPLICATION_DEV", "role": "DAILY_EXPENSE_TRACKER_FINTECH_APPLICATION_PIPELINE_ROLE", "private_key_file": "/opt/daily-expense-tracker-fintech-application/.secrets/dev_sandbox.p8"}}'
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PRIVATE_KEY_PATH=/opt/daily-expense-tracker-fintech-application/.secrets/dev_sandbox.p8

# K-15: airbyte (default once Airbyte is running) or python (fallback loader)
INGESTION_MODE=python
SOURCE_POSTGRES_DSN=host=host.docker.internal port=5433 dbname=daily_expense_tracker_fintech_application_source user=retail password=retail
# AIRFLOW_CONN_AIRBYTE_LOCAL='{"conn_type": "airbyte", "host": "http://host.docker.internal:8000/api/public/v1/", "login": "<client_id>", "password": "<client_secret>"}'
# AIRBYTE_CONNECTION_ID=
